# ─────────────────────────────────────────────────────────────────────────────
# twilio/send-message@0.3.4  —  TaxFax chase engine: SMS delivery
#
# The chase engine writes { to, body, chase } to the `messages` collection; this
# extension sends the SMS via Twilio and, through its statusCallback HTTP
# function, writes a `delivery` field back that delivery.ts mirrors onto the
# ChaseMessage. Function code never talks to the Twilio API.
#
# Non-secret params only. TWILIO_AUTH_TOKEN is a Secret Manager value and lives
# in `extensions/twilio-send-message.secret.local` (git-ignored) — never here.
# ─────────────────────────────────────────────────────────────────────────────

LOCATION=us-central1

# ⚠ PLACEHOLDER — your Twilio Account SID (starts with AC...).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ⚠ PLACEHOLDER — prefer a Messaging Service (required for A2P 10DLC compliance
#   when texting US taxpayers at scale). If set, it wins over TWILIO_PHONE_NUMBER.
TWILIO_MESSAGING_SERVICE_SID=

# ⚠ PLACEHOLDER — fallback single sending number in E.164. 555-01xx is a
#   reserved fictional range; replace with your real Twilio number.
TWILIO_PHONE_NUMBER=+15555550123

MESSAGE_COLLECTION=messages
