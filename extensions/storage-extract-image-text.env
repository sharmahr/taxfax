# ─────────────────────────────────────────────────────────────────────────────
# googlecloud/storage-extract-image-text@0.1.9  —  OCR for the ingestion pipeline
#
# WHY IT IS INSTALLED: phone photos of W-2s / 1099s / K-1s arrive as HEIC/JPG
# with no embedded text, so `unpdf` (PDF text) can't read them. This extension
# runs Cloud Vision OCR on image uploads and writes the extracted text to
# Firestore, where the ingestion classifier matches it against the taxonomy in
# packages/shared/src/taxonomy.ts. No secrets — uses the project's Vision API.
#
# COLLECTION_PATH below is a contract, not a preference: functions/src/ingest/
# extract.ts reads the OCR text back out of that exact collection (OCR_COLLECTION
# — `OCR_TEXT_COLLECTION` if set, otherwise 'ocrText'). Change one side without
# the other and every image upload silently degrades to filename-only
# classification: no error, just worse answers.
# ─────────────────────────────────────────────────────────────────────────────

LOCATION=us-central1

# Project default bucket (from web/src/lib/firebase.ts).
IMG_BUCKET=taxfax-364f6.firebasestorage.app

# Extracted OCR text lands here for the classifier to read. Must match the
# collection functions/src/ingest/extract.ts reads (default 'ocrText').
COLLECTION_PATH=ocrText

# Uploads live under firms/{firmId}/{taxYear}/{clientId}/... — restrict OCR to
# that tree so firm logos and other assets aren't needlessly scanned.
INCLUDE_PATH_LIST=/firms

# "basic" writes just the text (all the taxonomy regexes need); "full" adds
# per-word geometry if the classifier later wants layout signals.
DETAIL=basic
