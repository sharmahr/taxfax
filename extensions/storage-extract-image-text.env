# ─────────────────────────────────────────────────────────────────────────────
# googlecloud/storage-extract-image-text@0.1.9  —  OCR for the be-ingest pipeline
#
# INCLUDED FOR be-ingest: phone photos of W-2s / 1099s / K-1s arrive as HEIC/JPG
# with no embedded text, so `unpdf` (PDF text) can't read them. This extension
# runs Cloud Vision OCR on image uploads and writes the extracted text to
# Firestore, where the be-ingest classifier matches it against the taxonomy in
# packages/shared/src/taxonomy.ts. No secrets — uses the project's Vision API.
#
# Coordinate the COLLECTION_PATH with the be-ingest agent before installing.
# ─────────────────────────────────────────────────────────────────────────────

LOCATION=us-central1

# Project default bucket (from web/src/lib/firebase.ts).
IMG_BUCKET=taxfax-364f6.firebasestorage.app

# Extracted OCR text lands here for the classifier to read.
COLLECTION_PATH=extractedText

# Uploads live under firms/{firmId}/{taxYear}/{clientId}/... — restrict OCR to
# that tree so firm logos and other assets aren't needlessly scanned.
INCLUDE_PATH_LIST=/firms

# "basic" writes just the text (all the taxonomy regexes need); "full" adds
# per-word geometry if the classifier later wants layout signals.
DETAIL=basic
