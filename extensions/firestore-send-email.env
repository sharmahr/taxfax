# ─────────────────────────────────────────────────────────────────────────────
# firebase/firestore-send-email@0.2.10  —  TaxFax chase engine: EMAIL delivery
#
# The chase engine writes a document to the `mail` collection; this extension
# renders and sends it, then writes a `delivery` field back that delivery.ts
# mirrors onto the ChaseMessage. Function code never talks to the SMTP provider.
#
# Non-secret params only. The SMTP password is a Secret Manager value and lives
# in `extensions/firestore-send-email.secret.local` (git-ignored) — never here.
# ─────────────────────────────────────────────────────────────────────────────

DATABASE=(default)

# ⚠ PLACEHOLDER — must equal your Firestore database location exactly, or the
#   extension's trigger fails to deploy. Check Console → Firestore → Location.
#   Common US values: nam5 (multi-region), us-central1, us-east4.
DATABASE_REGION=nam5

AUTH_TYPE=UsernamePassword

# ⚠ PLACEHOLDER — your transactional email provider's SMTP endpoint. Username in
#   the URI, password in the .secret.local file. Port 465 (SMTPS) or 587
#   (STARTTLS); port 25 is blocked on Google Cloud.
SMTP_CONNECTION_URI=smtps://apikey@smtp.YOUR-EMAIL-PROVIDER.example:465

MAIL_COLLECTION=mail

# ⚠ PLACEHOLDER — a sender verified (SPF/DKIM) on YOUR domain. The chase engine
#   sets a per-message `from` display name and a per-firm `replyTo`, so replies
#   reach each firm's inbox while the envelope stays on a deliverable domain.
DEFAULT_FROM=TaxFax <no-reply@mail.YOUR-DOMAIN.example>

DEFAULT_REPLY_TO=

# Auto-expire queue docs 3 months after send so `mail` self-cleans post-season.
# (Enable a Firestore TTL policy on the `mail.delivery.expireAt` field.)
TTL_EXPIRE_TYPE=month
TTL_EXPIRE_VALUE=3
